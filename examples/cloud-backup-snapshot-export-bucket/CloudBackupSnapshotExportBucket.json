{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "This template grants Atlas access to the specified bucket for exporting backup snapshots.",
  "Parameters": {
    "Profile": {
      "Type": "String",
      "Description": "MongoDB Atlas Profile for APIKeys",
      "Default": "default"
    },
    "MongoDBAtlasProjectId": {
      "Type": "String",
      "Description": "Atlas project ID."
    },
    "IamRoleID": {
      "Type": "String",
      "Description": "Atlas Cloud Provider Access registration ID, not an IAM role ARN. The registration must already be authorized for the IAM role that can access the S3 bucket."
    },
    "BucketName": {
      "Type": "String",
      "Description": "Name of the existing S3 bucket to register as a snapshot export destination."
    }
  },
  "Mappings": {},
  "Resources": {
    "CloudBackupSnapshotExportBucket": {
      "Type": "MongoDB::Atlas::CloudBackupSnapshotExportBucket",
      "Properties": {
        "ProjectId": {
          "Ref": "MongoDBAtlasProjectId"
        },
        "IamRoleID": {
          "Ref": "IamRoleID"
        },
        "BucketName": {
          "Ref": "BucketName"
        },
        "Profile": {
          "Ref": "Profile"
        }
      }
    }
  },
  "Outputs": {
    "SnapshotExportBucketId": {
      "Value": {
        "Fn::GetAtt": [
          "CloudBackupSnapshotExportBucket",
          "Id"
        ]
      }
    }
  }
}
